---
import Maison from '../layouts/Maison.astro';
import { UI, CALENDAR_URL, base, type Lang } from '../i18n/site';

// Étude de cas anonymisée à la demande du client : ni nom, ni produit, ni domaine,
// ni capture du site. Les visuels sont des schémas.
// Sources : dépôt du site, système MKT (docs/mtkt), dépôt d'automatisation analytics,
// Search Console (glissement annuel au 26 août 2026).

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const fr = lang === 'fr';
const path = '/case-studies/benefits-fintech';
const altPath = fr ? path : `/fr${path}`;

const c = fr
  ? {
      meta: {
        title: 'Fintech belge des avantages salariés · étude de cas Foxyline',
        description:
          'Refonte en trois langues, chaîne de production marketing où l’IA rédige et l’équipe valide, et toutes les données marketing réunies dans un seul tableau de bord.',
      },
      kicker: 'Étude de cas · Fintech belge · 2026',
      title: 'Un site, une chaîne de contenu,',
      titleAccent: 'un seul tableau de bord.',
      sub: 'Un acteur belge des avantages salariés : un site refondu en trois langues, une équipe marketing qui publie elle-même avec l’IA, et des données jusque-là éparpillées dans sept outils, enfin réunies.',
      anon: 'Client anonymisé à sa demande',
      figures: [
        { value: '5,4', label: 'position de l’accueil français, contre 10,8' },
        { value: '1 900', label: 'visites par trimestre sur les pages sectorielles' },
        { value: '3', label: 'langues, avec des adresses traduites' },
        { value: '0', label: 'export Excel pour suivre le marketing' },
      ],
      figNote: 'Search Console, en glissement annuel au 26 août 2026. Les pages de connexion sont remontées aux positions 2,1 et 2,2 sur des adresses entièrement neuves.',
      site: {
        n: '01',
        title: 'Un site que le marketing fait vivre.',
        body: [
          'L’ancien site WordPress et un sous-site séparé ont été réunis dans un site statique unique, en français, néerlandais et anglais, avec des adresses traduites dans chaque langue.',
          'Une famille de pages est générée à partir de données : une page par commission paritaire, en français et en néerlandais. Chaque page porte un seul graphe de données structurées, et une copie en Markdown est servie aux assistants IA.',
          'La plupart des personnes qui modifient le site sont des marketeurs, pas des développeurs. Chaque changement passe par trois environnements et deux relectures avant la mise en ligne.',
        ],
        rows: [
          { k: 'Langues', v: 'FR · NL · EN' },
          { k: 'Pages', v: '≈ 130' },
          { k: 'Articles', v: '271', d: '108 FR · 118 NL · 45 EN' },
          { k: 'Redirections 301', v: '107', d: 'depuis les adresses WordPress' },
          { k: 'Sous-site', v: '1', d: 'fusionné dans le site principal' },
          { k: 'Mise en ligne', v: '3 étapes', d: 'développement, recette, production' },
        ],
      },
      mkt: {
        n: '02',
        title: 'L’IA rédige, l’équipe valide.',
        body: [
          'La production marketing suit une boucle en six temps, de l’insight au bilan à trente jours. Une règle la tient : pas d’insight validé, pas de brief ; pas de brief, pas de travail.',
          'L’IA rédige les brouillons dans les trois langues et prépare la page. L’équipe apporte ce qu’elle seule sait : la preuve belge, la nuance fiscale, la voix de la marque. Un partenaire technique relit le code, l’équipe marketing relit la page, en parallèle.',
          'L’objectif affiché : qu’une équipe de six à dix personnes passe de dix à cent contenus par trimestre, sans recruter.',
        ],
        steps: [
          { k: 'Insight', v: 'Validé dans la base de connaissance', who: 'Équipe' },
          { k: 'Brief', v: 'Rattaché à un insight, sinon rien', who: 'Équipe' },
          { k: 'Brouillon', v: 'Rédigé en FR, NL et EN', who: 'IA' },
          { k: 'Page', v: 'Construite, avec un aperçu à relire', who: 'IA' },
          { k: 'Relecture', v: 'Code et page, en parallèle', who: 'Équipe' },
          { k: 'Bilan', v: 'Mesuré trente jours après', who: 'Équipe' },
        ],
      },
      data: {
        n: '03',
        title: 'Sept sources, un tableau de bord.',
        body: [
          'Analytics, campagnes payantes, Search Console, comportement des visiteurs, CRM et suivi SEO vivaient chacun dans leur outil, et se recoupaient dans des tableurs. Ils alimentent désormais un seul moteur et une seule base.',
          'Le tableau de bord reconstruit en direct le plan média que l’équipe tenait à la main. Les mêmes données sont interrogeables par un assistant IA, et deux tâches automatiques tournent chaque nuit.',
          'En chemin, la mesure a été corrigée : sur 105 prospects attribués à une régie, 99 n’avaient jamais cliqué. Seuls les clics comptent désormais.',
        ],
        sources: ['GA4', 'Google Ads', 'Meta Ads', 'Search Console', 'Clarity', 'Salesforce · Pardot', 'Suivi SEO et GEO'],
        engine: ['Un moteur d’automatisation', 'Une base de données'],
        outputs: ['Tableau de bord', 'Assistant IA', 'Contrôles chaque nuit'],
        schemaLabel: 'Schéma : sept sources de données alimentent un moteur et une base, qui servent un tableau de bord, un assistant IA et des contrôles automatiques.',
      },
      next: {
        title: 'Ce qui reste à faire.',
        body: 'Le chiffre d’affaires n’est pas encore attribuable campagne par campagne : les prospects ne sont pas convertis dans le CRM et les paramètres de campagne ne sont renseignés qu’une fois sur dix. C’est le prochain chantier, et le tableau de bord le montre plutôt que de le cacher.',
      },
      back: 'Voir les autres travaux',
      endTitle: 'Un appel de trente minutes pour commencer.',
    }
  : {
      meta: {
        title: 'Belgian employee-benefits fintech · Foxyline case study',
        description:
          'A rebuild in three languages, a marketing production line where AI drafts and the team signs off, and every marketing data source in a single dashboard.',
      },
      kicker: 'Case study · Belgian fintech · 2026',
      title: 'One site, one content line,',
      titleAccent: 'one dashboard.',
      sub: 'A Belgian employee-benefits provider: a site rebuilt in three languages, a marketing team that publishes on its own with AI, and data that used to sit in seven tools, finally brought together.',
      anon: 'Client anonymised at their request',
      figures: [
        { value: '5.4', label: 'French homepage position, from 10.8' },
        { value: '1,900', label: 'visits a quarter on the sector pages' },
        { value: '3', label: 'languages, with translated URLs' },
        { value: '0', label: 'Excel exports to track marketing' },
      ],
      figNote: 'Search Console, year on year to 26 Aug 2026. The login pages climbed to positions 2.1 and 2.2 on brand-new URLs.',
      site: {
        n: '01',
        title: 'A site that marketing runs.',
        body: [
          'The old WordPress site and a separate sub-site were merged into one static site, in French, Dutch and English, with URLs translated in each language.',
          'One family of pages is generated from data: a page per joint committee, in French and Dutch. Every page carries a single structured-data graph, and a Markdown copy is served to AI assistants.',
          'Most of the people who change the site are marketers, not developers. Every change goes through three environments and two reviews before it goes live.',
        ],
        rows: [
          { k: 'Languages', v: 'FR · NL · EN' },
          { k: 'Pages', v: '≈ 130' },
          { k: 'Articles', v: '271', d: '108 FR · 118 NL · 45 EN' },
          { k: '301 redirects', v: '107', d: 'from the WordPress URLs' },
          { k: 'Sub-site', v: '1', d: 'merged into the main site' },
          { k: 'Release', v: '3 stages', d: 'development, staging, production' },
        ],
      },
      mkt: {
        n: '02',
        title: 'AI drafts, the team signs off.',
        body: [
          'Marketing production follows a six-step loop, from insight to a thirty-day review. One rule holds it together: no validated insight, no brief; no brief, no work.',
          'AI drafts in all three languages and prepares the page. The team adds what only it knows: Belgian proof, tax nuance, the brand’s voice. A technical partner reviews the code and the marketing team reviews the page, in parallel.',
          'The stated goal: for a team of six to ten people to go from ten to a hundred pieces of content a quarter, without hiring.',
        ],
        steps: [
          { k: 'Insight', v: 'Validated in the knowledge base', who: 'Team' },
          { k: 'Brief', v: 'Tied to an insight, or nothing', who: 'Team' },
          { k: 'Draft', v: 'Written in FR, NL and EN', who: 'AI' },
          { k: 'Page', v: 'Built, with a preview to review', who: 'AI' },
          { k: 'Review', v: 'Code and page, in parallel', who: 'Team' },
          { k: 'Review at 30 days', v: 'Measured a month later', who: 'Team' },
        ],
      },
      data: {
        n: '03',
        title: 'Seven sources, one dashboard.',
        body: [
          'Analytics, paid campaigns, Search Console, visitor behaviour, CRM and SEO tracking each lived in their own tool and were reconciled in spreadsheets. They now feed a single engine and a single database.',
          'The dashboard rebuilds, live, the media plan the team used to keep by hand. The same data can be queried by an AI assistant, and two automated jobs run every night.',
          'Along the way the measurement was fixed: of 105 leads credited to one ad network, 99 had never clicked. Only clicks count now.',
        ],
        sources: ['GA4', 'Google Ads', 'Meta Ads', 'Search Console', 'Clarity', 'Salesforce · Pardot', 'SEO and GEO tracking'],
        engine: ['An automation engine', 'A database'],
        outputs: ['Dashboard', 'AI assistant', 'Nightly checks'],
        schemaLabel: 'Diagram: seven data sources feed one engine and one database, which serve a dashboard, an AI assistant and automated checks.',
      },
      next: {
        title: 'What is left to do.',
        body: 'Revenue cannot yet be attributed campaign by campaign: leads are not converted in the CRM and campaign parameters are filled in only one time in ten. That is the next piece of work, and the dashboard shows it rather than hiding it.',
      },
      back: 'See the other work',
      endTitle: 'A thirty-minute call to start.',
    };

// Schéma de centralisation : positions dans un repère 900 × 470.
const srcY = c.data.sources.map((_, i) => 40 + i * 64);
const outY = [120, 235, 350];
---

<Maison lang={lang} title={c.meta.title} description={c.meta.description} altPath={altPath}>
  <div slot="hero" class="hero court">
    <p class="kicker k-in">
      <svg aria-hidden="true" width="10" height="8" viewBox="0 0 12 8"><path d="M0 0 H12 L6 8 Z" fill="currentColor" /></svg>
      {c.kicker}
    </p>
    <h1 class="display">{c.title} <span class="accent">{c.titleAccent}</span></h1>
    <div class="hero-pied">
      <p class="chapo l-in">{c.sub}</p>
      <p class="repere b-in">{c.anon}</p>
    </div>
  </div>

  <!-- Chiffres -->
  <section aria-label={fr ? 'En chiffres' : 'In figures'}>
    <div class="wrap">
      <div class="cotes">
        {c.figures.map((f, i) => (
          <div class="cote-bloc">
            <span class="cote-val" data-count>{f.value}</span>
            <span class="cote" aria-hidden="true" style={`--d:${i}`}><i /><b />{i === c.figures.length - 1 && <i />}</span>
            <span class="cote-txt rv" style={`--d:${i}`}>{f.label}</span>
          </div>
        ))}
      </div>
      <p class="note rv" style="padding-bottom: 1rem; max-width: 46rem;">{c.figNote}</p>
    </div>
  </section>

  <!-- 01 · Le site -->
  <section class="band sable" aria-labelledby="site-titre">
    <div class="wrap cas-bloc">
      <div class="cas-texte">
        <span class="repere rv">{c.site.n}</span>
        <h2 id="site-titre" class="h2 rv">{c.site.title}</h2>
        <div class="texte">{c.site.body.map((p, i) => <p class="rv" style={`--d:${i}`}>{p}</p>)}</div>
      </div>
      <div class="fiche-cas chev">
        <dl>
          {c.site.rows.map((r) => (
            <div class="fiche-ligne">
              <dt class="repere">{r.k}</dt>
              <dd><strong>{r.v}</strong>{'d' in r && <span>{r.d}</span>}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 02 · Le marketing -->
  <section class="band" aria-labelledby="mkt-titre">
    <div class="wrap cas-bloc inverse">
      <div class="cas-texte">
        <span class="repere rv">{c.mkt.n}</span>
        <h2 id="mkt-titre" class="h2 rv">{c.mkt.title}</h2>
        <div class="texte">{c.mkt.body.map((p, i) => <p class="rv" style={`--d:${i}`}>{p}</p>)}</div>
      </div>
      <ol class="chaine">
        {c.mkt.steps.map((s, i) => (
          <li class:list={['chaine-pas rv', { ia: s.who === 'IA' || s.who === 'AI' }]} style={`--d:${i}`}>
            <span class="chaine-n repere">{String(i + 1).padStart(2, '0')}</span>
            <span class="chaine-k">{s.k}</span>
            <span class="chaine-v">{s.v}</span>
            <span class="chaine-qui">{s.who}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 · La centralisation -->
  <section class="band on-dark" aria-labelledby="data-titre">
    <div class="wrap">
      <div class="deux" style="margin-bottom: 3.5rem;">
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <span class="repere rv" style="color: var(--renard-clair);">{c.data.n}</span>
          <h2 id="data-titre" class="h2 rv">{c.data.title}</h2>
        </div>
        <div class="texte">{c.data.body.map((p, i) => <p class="rv" style={`--d:${i}`}>{p}</p>)}</div>
      </div>

      <figure class="schema chev">
        <svg viewBox="0 0 900 470" role="img" aria-label={c.data.schemaLabel}>
          <g fill="none" stroke="rgba(245,242,236,0.28)" stroke-width="1">
            {srcY.map((y) => <path d={`M190 ${y} H 260 L 330 235 H 360`} />)}
            {outY.map((y) => <path d={`M560 235 H 600 L 650 ${y} H 690`} />)}
          </g>
          {srcY.map((y, i) => (
            <g>
              <rect x="10" y={y - 20} width="180" height="40" rx="2" fill="none" stroke="rgba(245,242,236,0.35)" />
              <text x="24" y={y + 5} fill="#E4E8E3" font-family="Switzer, sans-serif" font-size="14">{c.data.sources[i]}</text>
            </g>
          ))}
          <rect x="360" y="165" width="200" height="140" rx="2" fill="#E07A45" />
          <path d="M452 186 H468 L460 197 Z" fill="#121A16" />
          <text x="460" y="232" text-anchor="middle" fill="#121A16" font-family="Switzer, sans-serif" font-size="15" font-weight="500">{c.data.engine[0]}</text>
          <text x="460" y="258" text-anchor="middle" fill="#121A16" font-family="Switzer, sans-serif" font-size="15">{c.data.engine[1]}</text>
          {outY.map((y, i) => (
            <g>
              <rect x="690" y={y - 24} width="200" height="48" rx="2" fill="#F5F2EC" />
              <text x="706" y={y + 5} fill="#121A16" font-family="Boska, serif" font-size="20">{c.data.outputs[i]}</text>
            </g>
          ))}
        </svg>
      </figure>
    </div>
  </section>

  <!-- La suite -->
  <section class="band" aria-labelledby="suite-titre">
    <div class="wrap deux">
      <h2 id="suite-titre" class="h2 rv">{c.next.title}</h2>
      <div class="texte">
        <p class="rv">{c.next.body}</p>
        <p class="rv" style="--d:1"><a class="lien" href={`${base(lang)}/#travaux`}>{c.back}</a></p>
      </div>
    </div>
  </section>

  <section class="fin on-dark band" aria-labelledby="fin-titre">
    <div class="fond" aria-hidden="true"><img src="/video/hero-motif.png" alt="" width="1920" height="1014" loading="lazy" /></div>
    <div class="wrap">
      <h2 id="fin-titre" class="rv">{c.endTitle}</h2>
      <a class="btn btn-renard rv" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">
        {t.book}<svg class="tri" aria-hidden="true" width="8" height="10" viewBox="0 0 8 12"><path d="M0 0 V12 L8 6 Z" fill="currentColor" /></svg>
      </a>
    </div>
  </section>
</Maison>
