---
import { Image } from 'astro:assets';
import Maison from '../layouts/Maison.astro';
import Mark from './Mark.astro';
import { HOME, VOICES, UI, CALENDAR_URL, EMAIL, base, type Lang } from '../i18n/site';
import { NETWORK_SITES } from '../i18n/network';
// Source unique de vérité des segments vidéo (exportée par Remotion avec la vidéo).
import timeline from '../data/scroll-timeline.json';

import rpe from '../assets/portfolio/rpe.webp';
import tapio from '../assets/portfolio/tapio.webp';
import portrait from '../assets/ludovic_laffineur.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = HOME[lang];
const t = UI[lang];
const voices = VOICES[lang];
const fr = lang === 'fr';
const b = base(lang);

// Les lieux du réseau sont saisis en anglais dans network.ts.
const PLACES_FR: Record<string, string> = {
  Brussels: 'Bruxelles', Ghent: 'Gand', Antwerp: 'Anvers', Belgium: 'Belgique',
  'Ixelles · Case study': 'Ixelles · Étude de cas',
};
const place = (p: string) => (fr ? PLACES_FR[p] ?? p : p);
const siteHref = (href: string, external: boolean) => (external ? href : `${b}${href}`);

/** Attributs d'une section pilotée : son segment vidéo, son poster de repli, sa hauteur de scroll. */
const seg = (id: string, o: { tenue?: boolean; pret?: number } = {}) => {
  const s = timeline.sections.find((x) => x.id === id)!;
  // Une section « tenue » reste à l'écran le temps d'une tenue (60 vh) avant de partir.
  const hauteur = o.tenue ? 'calc(100svh + 60vh)' : `${'scrollVh' in s ? s.scrollVh : 100}vh`;
  return {
    'data-video-in': s.in,
    'data-video-out': s.out,
    'data-pret': o.pret,
    style: `--poster-l: url(/fx/poster-16x9-${s.poster}.jpg); --poster-p: url(/fx/poster-9x16-${s.poster}.jpg); min-height: ${hauteur};`,
  };
};
const hero = timeline.sections.find((x) => x.id === 'hero')!;

/** Un titre dont chaque mot sort de sa ligne. */
const mots = (s: string) => s.split(' ');
---

<Maison
  lang={lang}
  title={d.meta.title}
  description={d.meta.description}
  ogAlt={d.meta.ogAlt}
  altPath={fr ? '/' : '/fr/'}
  intro
  fond="none"
  fx={{ in: hero.in, out: hero.out, poster: hero.poster }}
>
  <!-- Couche vidéo : fixe, plein écran, sans aucun texte. La source est choisie par le script
       selon l'orientation ; sans JS, rien n'est téléchargé et les posters suffisent. -->
  <div slot="fx" class="fx-bg" aria-hidden="true">
    <video
      muted
      playsinline
      preload="auto"
      disablepictureinpicture
      data-landscape={`/fx/${timeline.videos.landscape}`}
      data-portrait={`/fx/${timeline.videos.portrait}`}
    ></video>
  </div>

  <div slot="hero" class="hero">
    <p class="kicker k-in">
      <svg aria-hidden="true" width="10" height="8" viewBox="0 0 12 8"><path d="M0 0 H12 L6 8 Z" fill="currentColor" /></svg>
      {d.kicker}
    </p>
    <h1 class="display" aria-label={[...d.title, ...d.titleAccent].join(' ')}>
      <span aria-hidden="true">
        {d.title.map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}
        <span class="accent">
          {d.titleAccent.map((w, i) => <><span class="mot" style={`--i:${i + d.title.length + 2}`}><span>{w}</span></span>{' '}</>)}
        </span>
      </span>
    </h1>
    <div class="hero-pied">
      <p class="chapo l-in">{d.sub}</p>
      <div class="actions b-in">
        <a class="btn btn-renard" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">
          {t.book}<svg class="tri" aria-hidden="true" width="8" height="10" viewBox="0 0 8 12"><path d="M0 0 V12 L8 6 Z" fill="currentColor" /></svg>
        </a>
        <a class="btn btn-trait" href="#travaux">{d.seeWork}</a>
      </div>
    </div>
  </div>

  <!-- 2 · Chiffres + Approche — papier -->
  <section class="fx-section tient" aria-labelledby="approche-titre" {...seg('chiffres-approche', { tenue: true })}>
    <div class="tient-in">
      <div class="wrap cotes" style="border-bottom: 1px solid var(--lin);">
      {d.figures.map((f, i) => (
        <div class="cote-bloc">
          <span class="cote-val" data-count>{f.value}</span>
          <span class="cote" aria-hidden="true" style={`--d:${i}`}><i /><b />{'end' in f && <i />}</span>
          <span class="cote-txt rv" style={`--d:${i}`}>{f.label}</span>
        </div>
      ))}
      </div>
      <div class="wrap deux band">
      <h2 id="approche-titre" class="h2 titre">{mots(d.approach.title).map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}</h2>
      <div class="texte">
        {d.approach.body.map((p, i) => <p class="rv" style={`--d:${i}`}>{p}</p>)}
      </div>
      </div>
    </div>
  </section>

  <!-- 3 · Travaux + réseau — sable -->
  <section id="travaux" class="fx-section sable band" aria-labelledby="travaux-titre" {...seg('travaux', { pret: 0 })}>
    <div class="wrap">
      <div class="tete">
        <h2 id="travaux-titre" class="h2 titre">{mots(d.work.title).map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}</h2>
        <p class="note rv">{d.work.note}</p>
      </div>

      <article class="travail">
        <figure class="capture chev">
          <Image src={rpe} alt={d.work.rpe.alt} widths={[640, 1040, 1600]} sizes="(min-width: 1280px) 720px, 100vw" loading="lazy" />
        </figure>
        <div class="fiche">
          <p class="repere rv">{d.work.rpe.meta}</p>
          <h3 class="h3 rv" style="--d:1">{d.work.rpe.title}</h3>
          <p class="texte rv" style="--d:2">{d.work.rpe.body}</p>
          <div class="chiffres rv" style="--d:3">
            {d.work.rpe.figures.map((f) => <div><strong>{f.value}</strong><span>{f.label}</span></div>)}
          </div>
          <a class="lien rv" style="--d:4" href="https://radiologypartnerseurope.com/" target="_blank" rel="noopener noreferrer">{d.work.rpe.link}</a>
        </div>
      </article>

      <div class="travaux-duo">
        <article>
          <figure class="capture chev">
            <Image src={tapio} alt={d.work.tapio.alt} widths={[560, 880, 1200]} sizes="(min-width: 1280px) 600px, 100vw" loading="lazy" />
          </figure>
          <div class="fiche">
            <p class="repere rv">{d.work.tapio.meta}</p>
            <h3 class="h3 rv" style="--d:1">{d.work.tapio.title}</h3>
            <p class="texte rv" style="--d:2">{d.work.tapio.body}</p>
            <a class="lien rv" style="--d:3" href="https://www.tapio.eco/" target="_blank" rel="noopener noreferrer">{d.work.tapio.link}</a>
          </div>
        </article>
        <article>
          <div class="panneau chev" style="--d:1" aria-hidden="true">
            <span class="repere">{d.work.fintech.panelNote}</span>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <span class="cote-val">79</span>
              <span class="cote"><i /><b /><i /></span>
              <span class="cote-txt">{d.work.fintech.panel}</span>
            </div>
          </div>
          <div class="fiche">
            <p class="repere rv">{d.work.fintech.meta}</p>
            <h3 class="h3 rv" style="--d:1">{d.work.fintech.title}</h3>
            <p class="texte rv" style="--d:2">{d.work.fintech.body}</p>
          </div>
        </article>
      </div>

      <div id="reseau" class="deux" style="margin: 7rem 0 3.5rem;">
        <h2 class="h2 titre">{mots(d.network.title).map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}</h2>
        <p class="texte rv">{d.network.body}</p>
      </div>
      <ul class="planches">
        {NETWORK_SITES.map((s, i) => (
          <li>
            <a
              class="planche"
              href={siteHref(s.href, s.external)}
              target={s.external ? '_blank' : undefined}
              rel={s.external ? 'noopener noreferrer' : undefined}
            >
              <span class="capture chev" style={`--d:${i % 4}`}>
                <Image src={s.image} alt={fr ? `Page d’accueil de ${s.name}` : `${s.name} homepage`} widths={[360, 560]} sizes="(min-width: 768px) 25vw, 100vw" loading="lazy" />
              </span>
              <span class="planche-nom">
                <span>{s.name}</span>
                <span class="repere">{place(s.place)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 · Méthode — papier : une seule cote, quatre repères -->
  <section id="methode" class="fx-section tient" aria-labelledby="methode-titre" {...seg('methode', { tenue: true, pret: 0 })}>
    <div class="tient-in band">
      <div class="wrap">
      <h2 id="methode-titre" class="h2 titre" style="max-width: 46rem; margin-bottom: 3.5rem;">{mots(d.method.title).map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}</h2>
      <ol class="etapes">
        {d.method.steps.map((s, i) => (
          <li class="etape">
            <span class="cote" aria-hidden="true" style={`--d:${i}`}><i /><b />{i === d.method.steps.length - 1 && <i />}</span>
            <span class="repere rv" style={`--d:${i * 2.5}`}>{s.when}</span>
            <h3 class="rv" style={`--d:${i * 2.5 + 1}`}>{s.name}</h3>
            <p class="rv" style={`--d:${i * 2.5 + 2}`}>{s.body}</p>
          </li>
        ))}
      </ol>
      <p class="texte rv" style="margin-top: 3rem;">{d.method.after}</p>
      </div>
    </div>
  </section>

  <!-- 5 · Studio — forêt, renard en filigrane derrière le portrait -->
  <section id="studio" class="fx-section on-dark tient" aria-labelledby="studio-titre" {...seg('studio', { tenue: true, pret: 0.85 })}>
    <div class="tient-in">
      <div class="wrap studio">
      <div class="studio-portrait rv">
        <Image src={portrait} alt={d.studio.alt} widths={[400, 800]} sizes="(min-width: 768px) 26rem, 80vw" loading="lazy" />
      </div>
      <div class="studio-texte">
        <h2 id="studio-titre" class="h2 titre">{mots(d.studio.title).map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}</h2>
        <div class="texte" style="font-size: 1.125rem;">
          {d.studio.body.map((p, i) => <p class="rv" style={`--d:${i + 1}`}>{p}</p>)}
        </div>
        <p class="signature rv" style="--d:3"><Mark size={22} color="#E07A45" snout="#E07A45" />Ludovic Laffineur</p>
      </div>
      </div>
    </div>
  </section>

  <!-- 6 · Paroles — papier -->
  <section class="fx-section tient" aria-labelledby="paroles-titre" {...seg('paroles', { tenue: true })}>
    <div class="tient-in band">
      <div class="wrap">
      <h2 id="paroles-titre" class="h2 titre" style="margin-bottom: 3rem;">{mots(d.voices.title).map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}</h2>
      <div class="paroles">
        {voices.map((v, i) => (
          <figure class="parole rv" style={`--d:${i}`}>
            <blockquote>{fr ? `« ${v.excerpt} »` : `“${v.excerpt}”`}</blockquote>
            <figcaption>
              <Image src={v.portrait} alt="" widths={[112]} loading="lazy" />
              <span><strong>{v.name}</strong><br />{v.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      </div>
    </div>
  </section>

  <!-- 7 · Contact — forêt ; la ligne de la vidéo se trace et finit sur le museau -->
  <section id="contact" class="fx-section fin on-dark tient" aria-labelledby="contact-titre" {...seg('contact', { tenue: true, pret: 0.85 })}>
    <div class="tient-in band">
      <div class="wrap">
      <h2 id="contact-titre" class="titre">{mots(d.contact.title).map((w, i) => <><span class="mot" style={`--i:${i}`}><span>{w}</span></span>{' '}</>)}</h2>
      <p class="chapo rv">{d.contact.body}</p>
      <div class="actions rv" style="--d:1">
        <a class="btn btn-renard" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">
          {t.book}<svg class="tri" aria-hidden="true" width="8" height="10" viewBox="0 0 8 12"><path d="M0 0 V12 L8 6 Z" fill="currentColor" /></svg>
        </a>
        <a class="ul mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="ul" href={`${b}/contact`} style="font-size: 0.9375rem; padding: 0.75rem 0;">{d.contact.brief}</a>
      </div>
      </div>
    </div>
  </section>
</Maison>

<script>
  // =========================================================
  // Fond vidéo piloté au scroll (brief v1, 14 octobre 2026).
  // Chaque section porte data-video-in / data-video-out ; on mesure sa plage
  // de scroll et on y fait correspondre son segment de vidéo. La vidéo ne se
  // lit jamais seule, sauf l'ouverture.
  // =========================================================
  const video = document.querySelector<HTMLVideoElement>('.fx-bg video');
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // L'ouverture se joue seule jusqu'ici : symbole construit, puis motif posé.
  // Le scroll prend la main ensuite, pour la vague du motif.
  const INTRO_FIN = 4.5;
  // Une section prend la main quand son haut atteint 15 % de la hauteur de l'écran :
  // le texte de la section précédente est alors sorti, son rideau peut balayer l'écran.
  const BASCULE = 0.15;
  // Quand le fond bascule entre clair et sombre, le texte de la section ne se révèle
  // qu'une fois son rideau joué (part du segment). Entre deux fonds clairs (papier, sable),
  // data-pret="0" : le texte se révèle dès qu'il entre à l'écran.
  const PRET = 0.6;
  const LISSAGE = 0.15;
  const FRAME = 1 / 30;

  // Sections tenues : le contenu colle à l'écran pendant la tenue. S'il est plus haut que
  // l'écran (mobile), il colle par le bas pour qu'on puisse quand même tout lire.
  // La tenue vaut 60 vh de plus que le contenu, même quand il dépasse l'écran.
  function colle() {
    for (const el of document.querySelectorAll<HTMLElement>('.tient-in')) {
      el.style.setProperty('--colle', `${Math.min(0, innerHeight - el.offsetHeight)}px`);
      const section = el.parentElement;
      if (section) section.style.minHeight = `${Math.max(el.offsetHeight, innerHeight) + 0.6 * innerHeight}px`;
    }
  }
  colle();
  new ResizeObserver(colle).observe(document.body);

  if (video && !reduit) demarre(video);

  function demarre(video: HTMLVideoElement) {
    const root = document.documentElement;
    const portrait = matchMedia('(orientation: portrait)');
    const source = () => (portrait.matches ? video.dataset.portrait : video.dataset.landscape) ?? '';

    type Plage = { el: HTMLElement; start: number; end: number; tin: number; tout: number; pret: number };
    let plages: Plage[] = [];

    function mesure() {
      const vh = innerHeight;
      const els = [...document.querySelectorAll<HTMLElement>('[data-video-in]')];
      const tops = els.map((el) => el.getBoundingClientRect().top + scrollY);
      const max = document.documentElement.scrollHeight - vh;
      const starts = els.map((_, i) => (i === 0 ? 0 : Math.max(0, tops[i] - BASCULE * vh)));
      plages = els.map((el, i) => {
        const start = starts[i];
        const suivante = i < els.length - 1 ? starts[i + 1] : max;
        // Le segment s'achève (image stable) tôt : à l'arrivée pour une section tenue (un peu
        // après le début de la tenue), au centrage du contenu sinon. Les gestes (rideau, logo)
        // se jouent pendant que le texte attend, puis le fond reste posé pendant la tenue.
        // Le hero garde toute sa plage, pour la vague du motif.
        const tenue = el.classList.contains('tient');
        const pose = tenue ? tops[i] + 0.45 * vh : tops[i] + el.offsetHeight / 2 - vh / 2;
        const end = i === 0 ? Math.max(start + 1, suivante) : Math.min(Math.max(suivante, start + 1), Math.max(start + 0.3 * vh, pose));
        const tin = Number(el.dataset.videoIn);
        return {
          el, start, end,
          tin: i === 0 ? Math.max(tin, INTRO_FIN) : tin,
          tout: Number(el.dataset.videoOut),
          pret: Number(el.dataset.pret ?? PRET),
        };
      });
      plages[0]?.el.classList.add('fx-pret');
      for (const p of plages) if (p.pret === 0) p.el.classList.add('fx-pret');
    }

    function cible(y: number) {
      let p = plages[0];
      for (const x of plages) {
        if (y < x.start) break;
        if (x !== p) p.el.classList.add('fx-pret');
        p = x;
      }
      const k = Math.min(1, Math.max(0, (y - p.start) / (p.end - p.start)));
      if (k >= p.pret) p.el.classList.add('fx-pret');
      // On s'arrête une image avant la sortie : la dernière image stable du segment.
      return p.tin + k * (p.tout - FRAME - p.tin);
    }

    let mode: 'intro' | 'scroll' = scrollY > 10 ? 'scroll' : 'intro';
    let t = 0;

    video.src = source();
    portrait.addEventListener('change', () => {
      const garde = video.currentTime;
      video.src = source();
      video.addEventListener('loadedmetadata', () => (video.currentTime = garde), { once: true });
    });

    video.addEventListener(
      'loadeddata',
      () => {
        mesure();
        root.classList.add('fx-on');
        if (mode === 'intro') {
          video.currentTime = 0;
          video.play().catch(() => passeAuScroll());
        } else {
          passeAuScroll();
        }
      },
      { once: true },
    );

    function passeAuScroll() {
      video.pause();
      mode = 'scroll';
      t = video.currentTime;
    }

    function image() {
      if (plages.length) {
        if (mode === 'intro') {
          if (video.currentTime >= INTRO_FIN || video.ended) passeAuScroll();
        } else {
          const vise = cible(scrollY);
          t += (vise - t) * LISSAGE;
          if (Math.abs(vise - t) < 0.002) t = vise;
          if (!video.seeking && Math.abs(video.currentTime - t) > 1 / 60) video.currentTime = t;
        }
      }
      requestAnimationFrame(image);
    }
    requestAnimationFrame(image);

    // Les hauteurs changent avec les polices, les images et le redimensionnement.
    new ResizeObserver(() => mesure()).observe(document.body);
    addEventListener('resize', mesure);
  }
</script>
