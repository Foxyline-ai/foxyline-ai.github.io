---
import { Image } from 'astro:assets';
import Vermillon from '../layouts/Vermillon.astro';
import { V, VOICES, CALENDAR_URL, type Lang } from '../i18n/vermillon';

import lacambreHome from '../assets/radiologielacambre/lacambre-home.png';
import lacambreBooking from '../assets/radiologielacambre/lacambre-booking.png';
import lacambreGeo from '../assets/radiologielacambre/lacambre-chatgpt-geo.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = V[lang];
const fr = lang === 'fr';
const path = '/case-studies/radiologie-la-cambre';
const altPath = fr ? path : `/fr${path}`;

// Maxime Bersou practises in the network, so his quote belongs here.
const voice = VOICES[lang][0];

const c = fr
  ? {
      meta: {
        title: 'Radiologie La Cambre — étude de cas Foxyline',
        description:
          'Un cabinet de radiologie bruxellois passé de zéro à la première page en 90 jours : refonte, référencement local et visibilité dans les moteurs IA.',
      },
      kicker: 'Étude de cas · Ixelles · 2025',
      lineA: 'De zéro',
      lineB: 'à la première',
      lineC: 'page.',
      sub: 'Un cabinet de radiologie à Ixelles, premier site du réseau à recevoir le traitement complet : architecture, contenu local, et présence dans les réponses des moteurs IA.',
      figures: [
        { value: '+37 %', label: 'Clics, en un an' },
        { value: '11,2', label: 'Position moyenne' },
        { value: '1 272', label: 'Visites / 90 jours' },
      ],
      figNote:
        'Mesuré dans Search Console sur la Belgique, période de 90 jours au 26 août 2026 comparée à la même période un an plus tôt. La position moyenne est passée de 14,2 à 11,2.',
      blocks: [
        {
          mark: '01 / Le site',
          title: 'Une page d’accueil construite autour du patient.',
          body: 'Prise de rendez-vous accessible dès le premier écran, examens et tarifs lisibles sans chercher, et une version néerlandaise complète — pas une traduction automatique posée par-dessus.',
          image: lacambreHome,
          alt: 'Radiologie La Cambre — page d’accueil',
        },
        {
          mark: '02 / La prise de rendez-vous',
          title: 'Le parcours qui compte vraiment.',
          body: 'Le reste du site existe pour amener ici. Le tunnel a été raccourci et le suivi installé pendant la construction, pas ajouté après coup.',
          image: lacambreBooking,
          alt: 'Radiologie La Cambre — prise de rendez-vous',
        },
        {
          mark: '03 / Les moteurs IA',
          title: 'Cité en réponse, pas seulement classé.',
          body: 'Les patients demandent désormais « un radiologue à Ixelles » à ChatGPT avant d’ouvrir Google. Le contenu a été structuré pour être repris dans ces réponses.',
          image: lacambreGeo,
          alt: 'Radiologie La Cambre cité par ChatGPT',
        },
      ],
      cascadeMark: '04 / Ensuite',
      cascadeTitle: 'Un site, puis un socle pour tout le réseau.',
      cascadeBody:
        'Ce qui a marché ici est devenu le modèle décliné sur les dix-sept autres cabinets : même architecture, même chaîne de déploiement, contenu et langue réglés localement. Chaque cabinet ressort dans sa ville au lieu de concurrencer les autres.',
      back: 'Voir tout le réseau',
    }
  : {
      meta: {
        title: 'Radiologie La Cambre — Foxyline case study',
        description:
          'A Brussels radiology practice from zero to page one in 90 days: rebuild, local search and visibility inside AI answers.',
      },
      kicker: 'Case study · Ixelles · 2025',
      lineA: 'From zero',
      lineB: 'to page',
      lineC: 'one.',
      sub: 'A radiology practice in Ixelles, the first site in the network to get the full treatment: architecture, local content, and a presence inside AI answers.',
      figures: [
        { value: '+37%', label: 'Clicks, year on year' },
        { value: '11.2', label: 'Average position' },
        { value: '1,272', label: 'Visits / 90 days' },
      ],
      figNote:
        'Measured in Search Console for Belgium, the 90 days to 26 Aug 2026 against the same period a year earlier. Average position moved from 14.2 to 11.2.',
      blocks: [
        {
          mark: '01 / The site',
          title: 'A homepage built around the patient.',
          body: 'Booking reachable from the first screen, examinations and pricing legible without hunting, and a full Dutch version — not machine translation layered on top.',
          image: lacambreHome,
          alt: 'Radiologie La Cambre — homepage',
        },
        {
          mark: '02 / Booking',
          title: 'The journey that actually matters.',
          body: 'The rest of the site exists to bring people here. The funnel was shortened and tracking was installed during the build rather than bolted on after.',
          image: lacambreBooking,
          alt: 'Radiologie La Cambre — booking',
        },
        {
          mark: '03 / AI answers',
          title: 'Cited in the answer, not just ranked.',
          body: 'Patients now ask ChatGPT for “a radiologist in Ixelles” before they open Google. The content was structured to be picked up in those answers.',
          image: lacambreGeo,
          alt: 'Radiologie La Cambre cited by ChatGPT',
        },
      ],
      cascadeMark: '04 / What followed',
      cascadeTitle: 'One site, then a backbone for the whole network.',
      cascadeBody:
        'What worked here became the template cascaded across the other seventeen practices: same architecture, same deploy pipeline, content and language set locally. Each practice ranks in its own town instead of competing with the others.',
      back: 'See the whole network',
    };
---

<Vermillon
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  altPath={altPath}
>
  <main id="main" tabindex="-1">
    <section class="wrap hero">
      <p class="tag">{c.kicker}</p>
      <h1 class="mega" style="margin-top: var(--s8);">
        <span class="hero-line">{c.lineA}</span>
        <span class="hero-line">{c.lineB}</span>
        <span class="hero-line"><span class="flat">{c.lineC}</span></span>
      </h1>
      <p class="lede hero-lede">{c.sub}</p>

      <div class="hero-foot">
        <dl class="counts">
          {c.figures.map((f) => (
            <div class="count">
              <dt class="tag">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
        <a class="go" href="https://radiologielacambre.be/" target="_blank" rel="noopener noreferrer">
          {fr ? 'Voir le site' : 'Visit the site'}<span class="arw" aria-hidden="true">→</span>
        </a>
      </div>
      <p class="tag fig-note">{c.figNote}</p>
    </section>

    {c.blocks.map((b) => (
      <section class="wrap band">
        <div class="band-head">
          <h2 class="big">{b.title}</h2>
          <p class="tag">{b.mark}</p>
        </div>
        <p class="body" style="margin-bottom: var(--s10);">{b.body}</p>
        <figure class="shot">
          <Image src={b.image} alt={b.alt} loading="lazy" widths={[760, 1240]} />
        </figure>
      </section>
    ))}

    <section class="wrap band">
      <div class="band-head">
        <h2 class="big">{c.cascadeTitle}</h2>
        <p class="tag">{c.cascadeMark}</p>
      </div>
      <p class="body">{c.cascadeBody}</p>

      <figure class="say say-solo">
        <blockquote>{voice.quote}</blockquote>
        <figcaption class="say-cap">
          <Image class="say-face" src={voice.portrait} alt={voice.name} loading="lazy" widths={[96, 192]} />
          <span>
            <span class="say-by">{voice.name}</span>
            <span class="tag say-role">{voice.role}</span>
          </span>
        </figcaption>
      </figure>

      <p style="margin-top: var(--s10);">
        <a class="go-2" href={fr ? '/fr/#network' : '/#network'}>{c.back}</a>
      </p>
    </section>
  </main>

  <section class="end">
    <div class="wrap end-in">
      <div>
        <p class="tag">{d.booking.mark}</p>
        <h2 class="big" style="margin-top: var(--s5); max-width: 14ch;">{d.booking.title}</h2>
        <p class="lede" style="margin-top: var(--s6);">{d.booking.body}</p>
      </div>
      <a class="go" href={CALENDAR_URL} target="_blank" rel="noopener noreferrer">
        {d.booking.cta}<span class="arw" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Vermillon>

<style is:global>
  .fig-note { margin-top: var(--s6); max-width: 68ch; line-height: 1.55; }
  .shot { margin: 0; border: 1px solid var(--rule); background: var(--paper-2); }
  .shot img { width: 100%; height: auto; display: block; }
  .say-solo { margin-top: var(--s12); padding-top: var(--s10); border-top: 1px solid var(--rule); }
</style>
