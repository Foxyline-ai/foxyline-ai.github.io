---
import { V, EMAIL, type Lang } from '../i18n/vermillon';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page in the other locale, for the language switch. */
  altPath: string;
  noindex?: boolean;
  /** Home pages carry the anchor nav; inner pages just link back. */
  anchors?: boolean;
}

const {
  lang,
  title,
  description,
  altPath,
  noindex = false,
  anchors = false,
} = Astro.props;

const d = V[lang];
const fr = lang === 'fr';
const home = fr ? '/fr/' : '/';
const siteUrl = 'https://foxyline.ai';
const canonical = new URL(Astro.url.pathname, siteUrl);
const altURL = new URL(altPath, siteUrl).href;
// One share card per locale: the headline on it is the headline of the page.
const ogImage = fr ? '/og-image-fr.png' : '/og-image.png';
const ogAlt = fr
  ? 'Foxyline — Vos objectifs ont doublé. Votre équipe, non.'
  : 'Foxyline — Your targets doubled. Your team didn’t.';
const skip = fr ? 'Aller au contenu' : 'Skip to content';
const back = fr ? 'Accueil' : 'Home';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link rel="alternate" hreflang={fr ? 'en' : 'fr'} href={altURL} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content="Foxyline" />
    <meta property="og:locale" content={fr ? 'fr_BE' : 'en_BE'} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content={`${siteUrl}${ogImage}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FF3B14" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/foxyline-ds/vermillon.css" />
    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">{skip}</a>

    <header class="bar">
      <div class="wrap bar-in">
        <a href={home} class="wordmark">Foxyline</a>
        <nav class="bar-nav" aria-label="Navigation">
          {anchors ? (
            <>
              <a href="#results" class="hide-sm">{d.nav.work}</a>
              <a href="#method" class="hide-sm">{d.nav.method}</a>
            </>
          ) : (
            <a href={home} class="hide-sm">{back}</a>
          )}
          <a href={`mailto:${EMAIL}`}>{d.nav.contact}</a>
          <a href={altPath}>{fr ? 'EN' : 'FR'}</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="foot">
      <div class="wrap foot-in">
        <span class="tag">© 2026 Foxyline · {d.footer.legal}</span>
        <span class="tag">
          <a class="ul" href={fr ? '/fr/terms' : '/terms'}>{fr ? 'Conditions' : 'Terms'}</a>
          &nbsp;·&nbsp; {d.footer.place}
        </span>
      </div>
    </footer>
  </body>
</html>
